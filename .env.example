# Supabase project URL and publishable key. Locally, copy them from `supabase status`.
# Both are safe in the browser: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the app, used in email links (sign-up confirmation, password reset).
# Optional locally (taken from the request); set it in production, e.g. https://clubintel.example.
SITE_URL=

# Supabase secret key (service_role), server-only. Used for one thing: the AI report writes,
# which only the server may make (src/lib/supabase/admin.ts). Locally, copy "Secret key" from
# `supabase status`. Never give it a NEXT_PUBLIC_ prefix or read it in a "use client" file.
SUPABASE_SECRET_KEY=

# AI reports (plan 06). AI_PROVIDER is "anthropic" (needs ANTHROPIC_API_KEY) or "fake" (a fixed
# sample report, no network: for local work and tests). Unset, it's anthropic when a key is set,
# and AI is off otherwise. ANTHROPIC_API_KEY is server-only: never give it a NEXT_PUBLIC_ prefix.
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5.
AI_MODEL=
